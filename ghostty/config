# Ghostty Configuration (Synced from Tilix)

# Font settings
font-family = "Cica"
font-size = 12

# Colors (Monokai-ish from Tilix)
background = #272822
foreground = #F8F8F2

# Palette
palette = 0=#272822
palette = 1=#F92672
palette = 2=#A6E22E
palette = 3=#F4BF75
palette = 4=#66D9EF
palette = 5=#AE81FF
palette = 6=#A1EFE4
